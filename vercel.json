{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/analyze.py": {
      "maxDuration": 120,
      "memory": 256,
      "includeFiles": "api/_gemini.py"
    },
    "api/thumbnails.py": {
      "maxDuration": 60,
      "memory": 256,
      "includeFiles": "api/_gemini.py"
    },
    "api/repurpose.py": {
      "maxDuration": 150,
      "memory": 256,
      "includeFiles": "api/_gemini.py"
    }
  },
  "rewrites": [
    {
      "source": "/thumbnails",
      "destination": "/thumbnails.html"
    },
    {
      "source": "/thumbnails/",
      "destination": "/thumbnails.html"
    },
    {
      "source": "/repurpose",
      "destination": "/repurpose.html"
    },
    {
      "source": "/repurpose/",
      "destination": "/repurpose.html"
    },
    {
      "source": "/:lang(ru|uk)",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(ru|uk)/",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(ru|uk)/:page(thumbnails|repurpose)",
      "destination": "/:lang/:page.html"
    },
    {
      "source": "/:lang(ru|uk)/:page(thumbnails|repurpose)/",
      "destination": "/:lang/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
